<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App logo at the top -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_description"
            android:maxHeight="140dp"
            android:scaleType="fitCenter"
            android:src="@drawable/pigeon_logo" />

        <!-- EditText fields -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etFirstName"
            android:hint="@string/first_name"
            android:inputType="textPersonName"
            android:autofillHints="givenName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:textColor="@color/colorOnBackground"
            app:hintTextColor="@color/colorOnBackground"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etLastName"
            android:hint="@string/last_name"
            android:inputType="textPersonName"
            android:autofillHints="familyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:textColor="@color/colorOnBackground"
            app:hintTextColor="@color/colorOnBackground"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etUsername"
            android:hint="@string/username"
            android:inputType="textEmailAddress"
            android:autofillHints="username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:textColor="@color/colorOnBackground"
            app:hintTextColor="@color/colorOnBackground"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etPassword"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:textColor="@color/colorOnBackground"
            app:hintTextColor="@color/colorOnBackground"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etConfirmPassword"
            android:hint="@string/confirm_password"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:textColor="@color/colorOnBackground"
            app:hintTextColor="@color/colorOnBackground"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etBirthdate"
            android:hint="@string/birthdate"
            android:inputType="text"
            android:focusable="false"
            android:clickable="true"
            android:autofillHints="birthDateDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:textColor="@color/colorOnBackground"
            app:hintTextColor="@color/colorOnBackground"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <AutoCompleteTextView
            android:id="@+id/etGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gender"
            android:background="@drawable/edittext_bg"
            android:textColor="@color/colorOnBackground"
            android:completionThreshold="1"
            android:dropDownHeight="wrap_content"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:inputType="none" />


        <!-- Profile image -->
        <ImageView
            android:id="@+id/ivProfileImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            android:padding="4dp" />

        <!-- Pick image button -->
        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/choose_profile_image"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/colorSurface"
            android:textColor="@color/colorOnSurface"
            android:padding="8dp"
            android:layout_gravity="center_horizontal" />

        <!-- Register button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="315dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/round_toggle_button"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/colorOnPrimary"
            android:padding="12dp"
            android:text="@string/register" />
        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Login here"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Dark mode toggle button -->
        <Button
            android:id="@+id/btnToggleTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/round_toggle_button"
            android:text="🌙"
            android:textColor="@color/colorOnBackground"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
